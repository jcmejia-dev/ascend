{
  "name": "ascend",
  "version": "2.0.0",
  "description": "A local-first developer learning and certification PWA",
  "scripts": {
    "test": "vitest run",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/build-sw.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json",
    "prebuild": "node scripts/prepare-build.mjs && node scripts/build-runner.mjs && node scripts/build-auth.mjs",
    "prestart": "node scripts/build-auth.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "cheerio": "^1.2.0",
    "codemirror": "^6.0.2",
    "idb": "^8.0.4",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
